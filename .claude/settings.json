{
  "permissions": {
    "allow": [
      "Bash(~/.claude/hooks/pr-workflow-guard record *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(!*.sample)",
      "Read(!*.example)",
      "Read(!*.template)",
      "Edit(.env*)",
      "Read(//**/.env)",
      "Read(//**/.env.bak)",
      "Read(//**/.env.local)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pr-workflow-guard hook"
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/role-agent-gate"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/role-skill-gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/decl-guard pre"
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lang-guard display"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/decl-guard display"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lang-guard batch"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/decl-guard batch"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lang-guard stop"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/decl-guard stop"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  },
  "skillOverrides": {
    "research-problem": "name-only",
    "research-requirements": "name-only",
    "research-verification": "name-only",
    "research-approaches": "name-only",
    "research-user-ideas": "name-only",
    "research-decision": "name-only"
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "custom:hiratch",
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "feedbackDrafts": "off"
}
