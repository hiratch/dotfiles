#!/usr/bin/env python3
"""ツールの呼び出しの直上に、画面に出る宣言の文があるかを確かめる。Claude Code の hook として使う。

ユーザーは、すべてのツールの呼び出しについて、何を・何故するのかを、その呼び出しの直上の文で読めることを前提にしている。
無言の呼び出しは、コマンドから動機を読み解く労力をユーザーに強い、委任の透明性を損なう。Claude が宣言を書いたつもりでも、
考えの中に書いた文は画面に出ないので、画面に出た文（MessageDisplay）で判定する。

- display: MessageDisplay の hook。画面に出た文があれば、このバッチに宣言があると控える
- pre: PreToolUse の hook。控えが無ければ、一度だけ呼び出しを止め、画面に出る文で宣言してから呼び直すよう知らせる。
  続けて止めると、宣言を画面に出せないときに作業が進まなくなるので、次の宣言が出るまでの 2 度目からは通す
- batch: PostToolBatch の hook。宣言の控えを空にする（次のバッチは新しい宣言を要する）。並列のバッチは 1 つの宣言でまとめて通る
- stop: Stop の hook。控えを空にする（前のターンの最終の回答を、次のターンの宣言と取り違えないため）

サブエージェントの呼び出しは、ユーザーが直接読む会話ではないので見ない。

使い方:
  decl-guard display|pre|batch|stop
      hook の入力 JSON を stdin から読み、止めるときは JSON を stdout に書く
"""

from __future__ import annotations

import json
import re
import sys
import tempfile
from pathlib import Path

SESSION_ID = re.compile(r"^[A-Za-z0-9_-]+$")
STATE_DIR = Path(tempfile.gettempdir()) / "claude-decl-guard"
REASON = (
    "この呼び出しの直上に、画面に出る文が無い。ユーザーは、呼び出しごとに何を・何故するのかを、その直上の文で読めることを前提にしている"
    "（無言の呼び出しは、コマンドから動機を読み解く労力を強い、委任の透明性を損なう）。考えの中に書いた文は画面に出ない。"
    "何を・何故するのかを、画面に出る文で書いてから、同じ呼び出しをし直す。この知らせへの返答や謝罪は要らない"
)


def state_path(event: dict) -> Path | None:
    session_id = str(event.get("session_id") or "")
    return STATE_DIR / f"{session_id}.json" if SESSION_ID.match(session_id) else None


def load(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def save(path: Path, state: dict) -> None:
    STATE_DIR.mkdir(mode=0o700, exist_ok=True)
    path.write_text(json.dumps(state))


def on_display(event: dict, path: Path) -> None:
    if (event.get("delta") or "").strip():
        save(path, {"declared": True})


def on_pre(event: dict, path: Path) -> None:
    state = load(path)
    if state.get("declared") or state.get("denied"):
        return
    save(path, {"denied": True})
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": REASON}}, ensure_ascii=False))


def on_batch(event: dict, path: Path) -> None:
    state = load(path)
    state.pop("declared", None)
    save(path, state)


def on_stop(event: dict, path: Path) -> None:
    path.unlink(missing_ok=True)


HANDLERS = {"display": on_display, "pre": on_pre, "batch": on_batch, "stop": on_stop}


def main() -> None:
    handler = HANDLERS.get(sys.argv[1] if len(sys.argv) > 1 else "")
    if handler is None:
        sys.exit(f"usage: decl-guard {'|'.join(HANDLERS)}")
    event = json.load(sys.stdin)
    path = state_path(event)
    if event.get("agent_id") or path is None:
        return
    handler(event, path)


if __name__ == "__main__":
    main()
