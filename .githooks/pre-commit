#!/bin/sh
# 公開リポジトリに組織固有の情報を入れないための検査。
# 検査する文字列は clone ごとの .git/info/sensitive-patterns に 1 行 1 つの正規表現で置く（文字列そのものを公開しないため）。
patterns="$(git rev-parse --git-common-dir)/info/sensitive-patterns"
if [ ! -s "$patterns" ]; then
    echo "pre-commit: $patterns が無いため、組織固有の情報の検査をしていない" >&2
    exit 0
fi

idents="$(git var GIT_AUTHOR_IDENT)
$(git var GIT_COMMITTER_IDENT)"
if printf '%s\n' "$idents" | grep -q -i -E -f "$patterns"; then
    echo "pre-commit: 作者またはコミッターが検査対象の文字列を含むため、commit を止めた。このリポジトリの user.email を確かめる" >&2
    exit 1
fi

matches=$(git diff --cached -U0 --no-color --no-renames --diff-filter=AM | awk '
    /^\+\+\+ / { file = substr($0, 7); next }
    /^\+/      { print file ": " substr($0, 2) }
' | grep -i -E -f "$patterns")
if [ -n "$matches" ]; then
    echo "pre-commit: 検査対象の文字列を含む行を追加しているため、commit を止めた:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
